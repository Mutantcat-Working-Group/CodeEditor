+async function getLanguagePackConfigurations(userDataPath: string, nlsMetadataPath: string): Promise<ILanguagePacks | undefined> {
 	const configFile = join(userDataPath, 'languagepacks.json');
+	let userLanguagePacks: ILanguagePacks | undefined;
+	try {
+		userLanguagePacks = JSON.parse(await promises.readFile(configFile, 'utf-8'));
+	} catch (err) {
+		// Do nothing. If we can't read the file we have no language pack config.
+	}
+
+	const bundledLanguagePacks = await getBundledLanguagePackConfigurations(nlsMetadataPath);
+	if (!userLanguagePacks) {
+		return bundledLanguagePacks;
+	}
+
+	// Packs the user installed win; whatever is missing comes from the bundle.
+	if (bundledLanguagePacks) {
+		for (const [language, languagePack] of Object.entries(bundledLanguagePacks)) {
+			if (!userLanguagePacks[language]) {
+				userLanguagePacks[language] = languagePack;
+			}
+		}
+	}
+
+	return userLanguagePacks;
+}
