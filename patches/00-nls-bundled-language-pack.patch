  * translation files.
  *
  * The file is updated whenever a new language pack is installed or removed.
+ * CodeEditor also ships a language pack of its own in `out/languagepacks`,
+ * which is used whenever the user has not installed a language pack.
  */
-async function getLanguagePackConfigurations(userDataPath: string): Promise<ILanguagePacks | undefined> {
+async function getLanguagePackConfigurations(userDataPath: string, nlsMetadataPath: string): Promise<ILanguagePacks | undefined> {
 	const configFile = join(userDataPath, 'languagepacks.json');
 	try {
 		return JSON.parse(await promises.readFile(configFile, 'utf-8'));
+	} catch (err) {
+		// Do nothing. If we can't read the file we have no language pack config.
+	}
+
+	const bundledRoot = join(nlsMetadataPath, 'languagepacks');
+	try {
+		const bundled = JSON.parse(await promises.readFile(join(bundledRoot, 'languagepacks.json'), 'utf-8')) as ILanguagePacks;
+		for (const languagePack of Object.values(bundled)) {
+			const translations = languagePack?.translations;
+			if (!translations) {
+				continue;
+			}
+
+			// The bundled pack points at its message bundles relative to its
+			// own folder. Turn those into absolute paths.
+			for (const [id, path] of Object.entries(translations)) {
+				if (typeof path === 'string' && !isAbsolute(path)) {
+					translations[id] = join(bundledRoot, path);
+				}
+			}
+		}
+
+		return bundled;
 	} catch (err) {
 		return undefined; // Do nothing. If we can't read the file we have no language pack config.
 	}
