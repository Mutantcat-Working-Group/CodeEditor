+	/**
+	 * The setting only describes an intention until argv.json carries the same
+	 * locale, so the runtime settings decide what the dropdown shows whenever they
+	 * were edited by hand or restored from somewhere else.
+	 */
+	private async reconcileLanguageSetting(): Promise<void> {
+		const configured = this.configurationService.getValue<string | undefined>(LANGUAGE_SETTING_ID);
+		const effective = toLanguageSettingValue(await this.readLocalePreference());
+		if ((configured ?? LANGUAGE_AUTO) === effective) {
+			return;
+		}
+
+		await this.configurationService.updateValue(LANGUAGE_SETTING_ID, effective, ConfigurationTarget.USER);
+	}
+
+	private async applyLanguageSetting(): Promise<void> {
+		const requested = toLanguageSettingValue(this.configurationService.getValue<string | undefined>(LANGUAGE_SETTING_ID));
+		const active = toLanguageSettingValue(await this.readLocalePreference());
+		if (requested === active) {
+			return;
+		}
+
+		const { confirmed } = await this.dialogService.confirm({
+			message: localize('codeEditorLanguageRestartMessage', "The display language changes when the editor restarts."),
+			detail: localize('codeEditorLanguageRestartDetail', "{0} restarts to apply the display language. Unsaved editors are restored afterwards.", this.productService.nameLong),
+			primaryButton: localize('codeEditorLanguageRestart', "Restart Now")
+		});
+
+		if (!confirmed) {
+			// Point the setting back at the language that is still in effect.
+			await this.configurationService.updateValue(LANGUAGE_SETTING_ID, active, ConfigurationTarget.USER);
+			return;
+		}
+
+		try {
+			await this.jsonEditingService.write(this.environmentService.argvResource, [{ path: ['locale'], value: requested === LANGUAGE_AUTO ? undefined : requested }], true);
