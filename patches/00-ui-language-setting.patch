+			const locale = (parsed as { locale?: unknown })?.locale;
+			return typeof locale === 'string' && locale.length > 0 ? locale : undefined;
+		} catch (err) {
+			return undefined; // Missing or unreadable runtime settings mean no preferred locale.
+		}
+	}
